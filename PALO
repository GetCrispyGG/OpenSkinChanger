-- Public random helpers
-- ------------------------------------------------------------
local function _randomizeSkin(wn)
    local _pool = _cosmeticPool("Skin", wn)
    if #_pool == 0 then return end
    _applyEquip(wn, "Skin", _pool[math.random(1, #_pool)])
end

_G.RandomizeSkin = _randomizeSkin

_G.RandomizeAllSkins = function()
    local _inv = _datCtrl:Get("WeaponInventory")
    if not _inv then return end
    for wn, _ in pairs(_inv) do
        _randomizeSkin(wn)
    end
end

_G.SetFavoritesOnly = function(state)
    _cfg.favoritesOnly = not not state
    _saveCfg()
end

if _cfg.randomOnLoad then
    task.defer(function()
        task.wait(1)
        pcall(_G.RandomizeAllSkins)
    end)
end
